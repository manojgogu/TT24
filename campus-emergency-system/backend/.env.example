# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/campus_emergency_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Hibernate DDL Auto (update for development)
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Secret (Min 256-bit base64 secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Location
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
